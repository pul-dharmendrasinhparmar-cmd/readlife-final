# Copy to .env.local for Next.js, and ensure DATABASE_URL is also available
# to Prisma (either the same .env.local loaded via scripts, or a root .env):
#   cp .env.example .env.local
#   cp .env.example .env
# Then fill real values. Restart `npm run dev` after any change.
#
# For Netlify: Site settings → Environment variables → add the same names.
# Do NOT put real keys in git.

# --- OpenAI (book recommendations / AI features) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional alias some docs still mention:
# NEXTAUTH_SECRET=

# App URL (local and production). Auth.js also accepts AUTH_URL.
# Local:  http://localhost:3000
# Netlify: https://YOUR-SITE.netlify.app
AUTH_URL=http://localhost:3000

# Google OAuth (optional — email/password works without these)
# Create credentials: Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Web application
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-SITE.netlify.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Database (Prisma) ---
# Local SQLite (default schema):
DATABASE_URL="file:./dev.db"
#
# Production (Neon Postgres on Netlify):
# 1) Create a free Neon project → copy the connection string
# 2) In prisma/schema.prisma set: provider = "postgresql"
# 3) Set DATABASE_URL to the Neon URL (include postgresql://…)
# 4) Run: npx prisma migrate deploy
